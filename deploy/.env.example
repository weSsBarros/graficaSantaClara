# Copie para a raiz do projeto com o nome .env e preencha.

# Endereço do sistema (o DNS do domínio precisa apontar para o IP do servidor).
DOMINIO=estoque.graficasantaclara.com.br

# Só se for usar o WhatsApp pela Evolution API (docker compose --profile whatsapp up -d).
# Use valores longos e aleatórios.
EVOLUTION_API_KEY=troque-por-uma-chave-grande-e-aleatoria
EVOLUTION_DB_PASSWORD=troque-esta-senha-tambem
